# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, used by the sign-up Admin API flow. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Azure OpenAI (Azure Portal -> Azure OpenAI resource -> Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
# Name of your deployed model (e.g. gpt-4o), not the base model name
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21
