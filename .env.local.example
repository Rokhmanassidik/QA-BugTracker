# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, used by scripts/seed-users.mjs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Azure OpenAI (Azure Portal -> Azure OpenAI resource -> Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
# Name of your deployed model (e.g. gpt-4o), not the base model name
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21

# PM/QA accounts used by the "Continue as PM/QA" login buttons.
# Run `npm run seed:users` after setting these to create the accounts in Supabase.
PM_EMAIL=pm@yourcompany.com
PM_PASSWORD=change-me
PM_FULL_NAME=Project Manager
QA_EMAIL=qa@yourcompany.com
QA_PASSWORD=change-me
QA_FULL_NAME=QA Engineer
